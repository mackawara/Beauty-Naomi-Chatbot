APP_ENV=local
PORT=3000

# MongoDB: either MONGODB_URI (e.g. local: mongodb://localhost:27017/beauty_naomi?replicaSet=rs0)
# or the Atlas (mongodb+srv) username/password/host below
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=cluster_path/database_name

# Redis
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379

# WhatsApp Cloud API
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_TOKEN=
WHATSAPP_APP_SECRET=
CATALOG_ID=

# WhatsApp Flows (booking Flow, see flows/README.md)
WHATSAPP_BOOKING_FLOW_ID=
WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----"
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# In-house scheduler (mackawara/scheduler)
SCHEDULER_API_URL=http://localhost:4100
SCHEDULER_API_KEY=
SCHEDULER_API_TIMEOUT=5000
SCHEDULER_WEBHOOK_SECRET=

# Message templates for scheduler notifications (optional overrides)
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_CANCELLED=booking_cancelled
WHATSAPP_TEMPLATE_RESCHEDULED=booking_rescheduled
