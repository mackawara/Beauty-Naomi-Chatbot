APP_ENV=local
PORT=3000

MONGODB_HOST=cluster_path/database_name
MONGODB_USERNAME=username
MONGODB_PASSWORD=password

REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_CONNECT_TIMEOUT=90000

# WhatsApp Cloud API
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=your-own-verify-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_TOKEN=
CATALOG_ID=

# Scheduler API. This service runs server-side, so it holds the SECRET key
# (sk_sched_...), printed once by the scheduler's seed script.
SCHEDULER_BASE_URL=http://localhost:4100
SCHEDULER_API_KEY=sk_sched_REPLACE_ME
# Signing secret the scheduler uses for its outbound webhooks; also printed by
# the seed script. Point the scheduler's BEAUTY_NAOMI_WEBHOOK_URL at
# https://<this-host>/scheduler/events
SCHEDULER_WEBHOOK_SECRET=
SALON_TIMEZONE=Africa/Harare

# WhatsApp Flow used for booking. Publish flows/booking-flow.json in the Meta
# dashboard, upload the matching public key, and keep the private key here.
WHATSAPP_BOOKING_FLOW_ID=
WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----"
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# Use "draft" until the Flow is published in the Meta dashboard.
WHATSAPP_FLOW_MODE=published
